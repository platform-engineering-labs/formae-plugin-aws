amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@aws/aws.pkl"

local testRunID = read("env:FORMAE_TEST_RUN_ID")
local stackName = "plugin-sdk-test-aws-config-auth-both-set-\(testRunID)"

forma {
  new formae.Stack {
    label = stackName
    description = "Plugin SDK fixture: both profile and auth set, expected to be rejected at eval"
  }

  new formae.Target {
    label = "aws-target"
    config = new aws.Config {
      region = "us-east-1"
      profile = "legacy-profile"
      auth = new aws.DefaultChainAuth {
        profile = "chain-profile"
      }
    }
  }
}
