amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@aws/aws.pkl"

local testRunID = read("env:FORMAE_TEST_RUN_ID")
local stackName = "plugin-sdk-test-aws-config-auth-oidc-\(testRunID)"

forma {
  new formae.Stack {
    label = stackName
    description = "Plugin SDK fixture: auth = OidcAuth"
  }

  new formae.Target {
    label = "aws-target"
    config = new aws.Config {
      region = "us-east-1"
      auth = new aws.OidcAuth {
        roleArn = "arn:aws:iam::123456789012:role/formae-agent"
      }
    }
  }
}
