amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@aws/aws.pkl"

import "@aws/iam/role.pkl"
import "@aws/logs/loggroup.pkl"
import "@aws/codebuild/project.pkl"
import "@aws/codebuild/imagebuild.pkl"

local testRunID = read("env:FORMAE_TEST_RUN_ID")
local accountID = read("env:FORMAE_TEST_ACCOUNT_ID")
local stackName = "plugin-sdk-test-codebuild-image-build-\(testRunID)"
local logGroupNameValue = "/formae/plugin-sdk-test/codebuild-image-build/\(testRunID)"
local regionValue = "us-east-1"

// The immutable pin. It is placed on the first build's manifest and never moved,
// so it stays a pullable reference to that image after the rebuild moves the
// mutable tag on to a new digest.
local pinTagValue = "sdk-pin-\(testRunID)"

// Push target for the built image: a PERSISTENT, formae-UNMANAGED prerequisite
// provisioned by scripts/ci/clean-environment.sh, which creates it if absent and
// empties it between runs but never deletes it. Retaining a pin is the whole
// point of this fixture, and a retained pin means the repository still holds an
// image when the stack is torn down; CloudControl refuses to delete a repository
// that still contains images, so managing the repository here made the
// whole-stack Destroy fail. `emptyOnDelete` does not rescue it — CloudControl's
// delete carries no resource model, so the repository's delete handler never
// sees the property. Referencing the repository by name keeps it out of formae's
// lifecycle, the same arrangement testdata/cloudtrail-trail.pkl uses for its
// log-delivery bucket.
//
// The URI and ARN are assembled literally because there is no managed resource
// to take a resolvable from, and because the replace variant interpolates the
// URI into the middle of a Dockerfile string, where a resolvable cannot go.
local repoNameValue = "formae-plugin-sdk-test-imgbuild-\(accountID)"
local repoUriValue = "\(accountID).dkr.ecr.\(regionValue).amazonaws.com/\(repoNameValue)"
local repoArnValue = "arn:aws:ecr:\(regionValue):\(accountID):repository/\(repoNameValue)"

// Placeholder build spec. The ImageBuild supplies the spec it runs as a per-build
// override, so the project's own spec is never read — it only has to be a
// well-formed spec the CodeBuild API accepts at create time.
local testBuildSpec = """
  version: 0.2
  phases:
    build:
      commands:
        - echo "plugin sdk test"
  """

// CloudWatch Logs destination for the build's logs.
local testLogGroup = new loggroup.LogGroup {
  label = "test-loggroup-for-image-build"
  logGroupName = logGroupNameValue
  retentionInDays = 1
}

// Service role the build runs as. It carries exactly what the generated
// image-build spec does and nothing more: an ECR authorization token, pulls and
// pushes against the one repository the image is pushed to, and log writes into
// the declared log group.
//
// logs:CreateLogGroup is deliberately absent. The log group is a declared
// resource that the project depends on, so it already exists when the build
// starts; a build that turned out to need the permission would be telling us the
// dependency edge is broken rather than that the policy is short a statement.
local buildRole = new role.Role {
  label = "image-build-project-role"
  roleName = "formae-sdk-test-imgbuild-role-\(testRunID)"
  assumeRolePolicyDocument {
    ["Version"] = "2012-10-17"
    ["Statement"] {
      new {
        ["Effect"] = "Allow"
        ["Principal"] {
          ["Service"] = "codebuild.amazonaws.com"
        }
        ["Action"] = "sts:AssumeRole"
      }
    }
  }
  policies {
    new {
      policyName = "image-build-ecr-and-logs"
      policyDocument {
        ["Version"] = "2012-10-17"
        ["Statement"] {
          // `aws ecr get-login-password` in the pre_build phase. The token is
          // registry-wide, so this action admits no resource scope.
          new {
            ["Effect"] = "Allow"
            ["Action"] = "ecr:GetAuthorizationToken"
            ["Resource"] = "*"
          }
          // `docker push` in the build phase, against the one repository the
          // image is pushed to.
          new {
            ["Effect"] = "Allow"
            ["Action"] {
              "ecr:BatchCheckLayerAvailability"
              "ecr:BatchGetImage"
              "ecr:GetDownloadUrlForLayer"
              "ecr:InitiateLayerUpload"
              "ecr:UploadLayerPart"
              "ecr:CompleteLayerUpload"
              "ecr:PutImage"
            }
            ["Resource"] = repoArnValue
          }
          // Build logs. A log group's ARN already carries a ":*" suffix, so it
          // covers the log streams under the group — which is what these two
          // actions are authorized against.
          new {
            ["Effect"] = "Allow"
            ["Action"] {
              "logs:CreateLogStream"
              "logs:PutLogEvents"
            }
            ["Resource"] = testLogGroup.res.arn
          }
        }
      }
    }
  }
}

// Build project the image build runs on. NO_SOURCE + NO_ARTIFACTS and a
// privileged Linux container are what the ImageBuild pre-flight requires.
local testProject = new project.Project {
  label = "test-project-for-image-build"
  name = "formae-plugin-sdk-test-imgbuild-project-\(testRunID)"
  description = "Plugin SDK test project for ImageBuild"
  serviceRole = buildRole.res.arn
  source {
    type = "NO_SOURCE"
    buildSpec = testBuildSpec
  }
  artifacts {
    type = "NO_ARTIFACTS"
  }
  environment {
    type = "LINUX_CONTAINER"
    computeType = "BUILD_GENERAL1_SMALL"
    image = "aws/codebuild/standard:7.0"
    privilegedMode = true
  }
  logsConfig {
    cloudWatchLogs {
      status = "ENABLED"
      groupName = testLogGroup.res.logGroupName
    }
  }
  timeoutInMinutes = 20
}

forma {
  new formae.Stack {
    label = stackName
    description = "Plugin SDK test for CodeBuild ImageBuild"
  }

  new formae.Target {
    label = "aws-target"
    config = new aws.Config {
      region = regionValue
    }
  }

  // Service role the build project runs as (referenced as a resolvable below).
  buildRole

  // Log group the build writes its logs to (referenced as a resolvable below).
  testLogGroup

  // Build project the image build runs on (referenced as a resolvable below).
  testProject

  // Resource under test — the Dockerfile gains a layer, which forces an in-place
  // rebuild under the same tag. The pin is redeclared unchanged, so it is carried
  // over rather than newly declared: it stays on the first build's manifest, that
  // manifest therefore still carries a tag, and the rebuild's predecessor prune
  // leaves it alone. The marker file this build writes is what the replace variant
  // uses to prove the pin did not move on to this manifest.
  new imagebuild.ImageBuild {
    label = "plugin-sdk-test-image-build"
    ecrRepositoryUri = repoUriValue
    imageTag = "sdk-test-\(testRunID)"
    additionalTags = new Listing { pinTagValue }
    dockerfile = "FROM public.ecr.aws/docker/library/alpine:3.20\nRUN true\nRUN touch /rebuilt\n"
    projectName = testProject.res.name
  }
}
