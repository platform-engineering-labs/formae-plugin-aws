amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@aws/aws.pkl"

import "@aws/ec2/vpc.pkl"
import "@aws/ec2/subnet.pkl"
import "@aws/ec2/internetgateway.pkl"
import "@aws/ec2/vpcgatewayattachment.pkl"
import "@aws/ec2/routetable.pkl"
import "@aws/ec2/route.pkl"
import "@aws/ec2/subnetroutetableassociation.pkl"
import "@aws/ecs/ecscluster.pkl"
import "@aws/ecs/taskdefinition.pkl"
import "@aws/ecs/service.pkl"
import "@aws/servicediscovery/privatednsnamespace.pkl"
import "@aws/servicediscovery/servicediscoveryservice.pkl"

local testRunID = read("env:FORMAE_TEST_RUN_ID")
local stackName = "plugin-sdk-test-ecs-svc-cloudmap-\(testRunID)"

// VPC + Subnet for FARGATE awsvpc networking. Both DNS attributes are on: the
// Cloud Map namespace below is backed by a Route53 private hosted zone
// associated with this VPC, which needs them.
local testVpc = new vpc.VPC {
  label = "test-vpc-for-ecs-svc-cloudmap"
  cidrBlock = "10.237.0.0/16"
  enableDnsSupport = true
  enableDnsHostnames = true
}

local testSubnet = new subnet.Subnet {
  label = "test-subnet-for-ecs-svc-cloudmap"
  vpcId = testVpc.res.vpcId
  cidrBlock = "10.237.1.0/24"
  availabilityZone = "us-east-1a"
}

// Internet routing: IGW + VPCGatewayAttachment + RouteTable + default Route +
// subnet association. FARGATE tasks need a public-IP egress path to pull
// container images from Docker Hub / ECR Public (no NAT in this fixture, so
// the service uses assignPublicIp=ENABLED below).
local testIgw = new internetgateway.InternetGateway {
  label = "test-igw-for-ecs-svc-cloudmap"
}

local testIgwAttachment = new vpcgatewayattachment.VPCGatewayAttachment {
  label = "test-igw-attachment-for-ecs-svc-cloudmap"
  vpcId = testVpc.res.vpcId
  internetGatewayId = testIgw.res.internetGatewayId
}

local testRouteTable = new routetable.RouteTable {
  label = "test-routetable-for-ecs-svc-cloudmap"
  vpcId = testVpc.res.vpcId
}

local testDefaultRoute = new route.Route {
  label = "test-default-route-for-ecs-svc-cloudmap"
  routeTableId = testRouteTable.res.routeTableId
  destinationCidrBlock = "0.0.0.0/0"
  gatewayId = testIgwAttachment.res.internetGatewayId
}

local testSubnetAssoc = new subnetroutetableassociation.SubnetRouteTableAssociation {
  label = "test-subnet-rtassoc-for-ecs-svc-cloudmap"
  subnetId = testSubnet.res.subnetId
  routeTableId = testRouteTable.res.routeTableId
}

// ECS Cluster.
local testCluster = new ecscluster.Cluster {
  label = "test-cluster-for-ecs-svc-cloudmap"
  clusterName = "formae-plugin-sdk-test-cm-cluster-\(testRunID)"
  clusterSettings {
    new {
      name = "containerInsights"
      value = "disabled"
    }
  }
}

// ECS TaskDefinition (FARGATE, awsvpc, nginx:latest on port 80).
local testTaskDef = new taskdefinition.TaskDefinition {
  label = "test-taskdef-for-ecs-svc-cloudmap"
  family = "formae-plugin-sdk-test-cm-taskdef-\(testRunID)"
  requiresCompatibilities {
    "FARGATE"
  }
  networkMode = "awsvpc"
  cpu = "256"
  memory = "512"
  containerDefinitions {
    new {
      name = "test-container"
      image = "nginx:latest"
      essential = true
      portMappings {
        new {
          containerPort = 80
          protocol = "tcp"
        }
      }
    }
  }
}

// Cloud Map namespace the tasks are registered in. Its domain name is unique to
// this fixture: a VPC can hold only one hosted zone per domain name, so sharing
// one with another fixture would make whichever namespace is created second
// fail.
local testNamespace = new privatednsnamespace.PrivateDnsNamespace {
  label = "test-namespace-for-ecs-svc-cloudmap"
  name = "formae-plugin-sdk-test-cmns-\(testRunID).local"
  vpc = testVpc.res.vpcId
  description = "Plugin SDK test namespace for ECS service discovery"
  properties = new privatednsnamespace.Properties {
    dnsProperties = new privatednsnamespace.DnsProperties {
      sOA = new privatednsnamespace.SOA {
        tTL = 60
      }
    }
  }
}

// Cloud Map service the ECS service registers its tasks with. An awsvpc task
// gets its own ENI, so an A record pointing at the task's private IP is the
// registration shape ECS uses; the TTL is short because the record set turns
// over with the tasks. Health is reported by ECS as it starts and stops tasks,
// which is what healthCheckCustomConfig means -- a Route53 healthCheckConfig is
// invalid in a private DNS namespace.
local testCloudMapService = new servicediscoveryservice.Service {
  label = "test-cloudmap-service-for-ecs-svc"
  name = "formae-plugin-sdk-test-cm-\(testRunID)"
  namespaceId = testNamespace.res.id
  description = "Plugin SDK test Cloud Map service for ECS registration"
  dnsConfig = new servicediscoveryservice.DnsConfig {
    routingPolicy = "MULTIVALUE"
    dnsRecords {
      new servicediscoveryservice.DnsRecord {
        type = "A"
        tTL = 15
      }
    }
  }
  healthCheckCustomConfig = new servicediscoveryservice.HealthCheckCustomConfig {
    failureThreshold = 1
  }
}

forma {
  new formae.Stack {
    label = stackName
    description = "Plugin SDK test for ECS Service with Cloud Map service registry"
  }

  new formae.Target {
    label = "aws-target"
    config = new aws.Config {
      region = "us-east-1"
    }
  }

  // Network plumbing.
  testVpc
  testSubnet

  // Internet routing so FARGATE tasks can pull container images.
  testIgw
  testIgwAttachment
  testRouteTable
  testDefaultRoute
  testSubnetAssoc

  // ECS plumbing.
  testCluster
  testTaskDef

  // Cloud Map plumbing (declared before the service that registers with it).
  testNamespace
  testCloudMapService

  // ECS Service under test -- last, the only resource of its type, and a leaf.
  // desiredCount=1 so a task actually runs and ECS actually registers an
  // instance with the Cloud Map service; a service with no tasks would create
  // the registry association without ever exercising it.
  //
  // assignPublicIp=ENABLED is required: there is no NAT gateway in this
  // fixture, so tasks reach the public internet (Docker Hub / ECR Public)
  // via the IGW + default route + public IPs on their ENIs.
  new service.Service {
    label = "plugin-sdk-test-ecs-service-with-cloudmap"
    serviceName = "formae-plugin-sdk-test-cm-svc-\(testRunID)"
    cluster = testCluster.res.arn
    taskDefinition = new formae.Resolvable {
      label = testTaskDef.label
      type = "AWS::ECS::TaskDefinition"
      property = "TaskDefinitionArn"
    }
    desiredCount = 1
    schedulingStrategy = "REPLICA"
    launchType = "FARGATE"
    networkConfiguration = new service.NetworkConfiguration {
      awsvpcConfiguration = new service.AwsVpcConfiguration {
        assignPublicIp = "ENABLED"
        subnets {
          testSubnet.res.subnetId
        }
      }
    }
    serviceRegistries {
      new service.ServiceRegistry {
        registryArn = testCloudMapService.res.arn
      }
    }
    deploymentConfiguration = new service.DeploymentConfiguration {
      maximumPercent = 200
      minimumHealthyPercent = 100
    }
  }
}
