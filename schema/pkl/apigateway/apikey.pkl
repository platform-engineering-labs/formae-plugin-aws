module aws.apigateway.apikey

import "@formae/formae.pkl"
import "../aws.pkl"

const type = "AWS::ApiGateway::ApiKey"

@aws.SubResourceHint
open class StageKey extends formae.SubResource {
    restApiId: (String|formae.Resolvable)?
    stageName: (String|formae.Resolvable)?
}

open class ApiKeyResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden id: ApiKeyResolvable = (this) {
        property = "APIKeyId"
    }

    hidden apiKeyId: ApiKeyResolvable = (this) {
        property = "APIKeyId"
    }
}

@aws.ResourceHint {
    type = module.type
    identifier = "APIKeyId"
}
open class ApiKey extends formae.Resource {

    @aws.FieldHint
    customerId: (String|formae.Resolvable)?

    @aws.FieldHint
    description: String?

    @aws.FieldHint
    enabled: Boolean?

    @aws.FieldHint{
        createOnly = true
        writeOnly = true
    }
    generateDistinctId: Boolean?

    @aws.FieldHint{createOnly = true}
    name: String?

    @aws.FieldHint { hasProviderDefault = true }
    stageKeys: Listing<StageKey>?

    @aws.FieldHint {
        updateMethod = "EntitySet"
        indexField = "Key"
    }
    tags: Listing<aws.Tag>?

    // The API key's own credential value, the string clients present in the
    // `x-api-key` header. Naming `formae.SecretValue` is what marks the field
    // opaque, so an author-supplied key is hashed at rest instead of persisting
    // in cleartext. `formae.GeneratorOutput` is deliberately absent: the field
    // is createOnly, so a drawn value could only land by replacing the API key,
    // and whether a generator may bind to a createOnly destination at all is
    // still an open decision. Widening later is additive; narrowing is not.
    @aws.FieldHint{createOnly = true; hasProviderDefault = true}
    value: (String|formae.Value|formae.SecretValue)?

    local parent = this

    hidden res: ApiKeyResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
