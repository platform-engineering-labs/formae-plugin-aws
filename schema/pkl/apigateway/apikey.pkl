module aws.apigateway.apikey

import "@formae/formae.pkl"
import "../aws.pkl"

const type = "AWS::ApiGateway::ApiKey"

@aws.SubResourceHint
open class StageKey extends formae.SubResource {
    restApiId: (String|formae.Resolvable)?
    stageName: (String|formae.Resolvable)?
}

open class ApiKeyResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden id: ApiKeyResolvable = (this) {
        property = "APIKeyId"
    }

    hidden apiKeyId: ApiKeyResolvable = (this) {
        property = "APIKeyId"
    }
}

@aws.ResourceHint {
    type = module.type
    identifier = "APIKeyId"
}
open class ApiKey extends formae.Resource {

    @aws.FieldHint
    customerId: (String|formae.Resolvable)?

    @aws.FieldHint
    description: String?

    @aws.FieldHint
    enabled: Boolean?

    @aws.FieldHint{
        createOnly = true
        writeOnly = true
    }
    generateDistinctId: Boolean?

    @aws.FieldHint{createOnly = true}
    name: String?

    @aws.FieldHint { hasProviderDefault = true }
    stageKeys: Listing<StageKey>?

    @aws.FieldHint {
        updateMethod = "EntitySet"
        indexField = "Key"
    }
    tags: Listing<aws.Tag>?

    // The API key's own credential value, the string clients present in the
    // `x-api-key` header. Naming the alias is what marks the field opaque, via
    // its `SecretValue` member, so an author-supplied key is hashed at rest
    // instead of persisting in cleartext.
    //
    // The alias includes `GeneratorOutput`, so the field accepts a generator
    // binding, the same as every other credential field here. The field is
    // createOnly, which bounds what such a binding can do rather than making it
    // meaningless: a generator with no rotation cadence draws once at create,
    // which is the case that replaces a PKL-eval-time `random.password` seed.
    // Whether a *rotating* generator may target a createOnly destination is an
    // admission-time question for the agent to answer, not one for a plugin
    // schema to pre-empt by refusing to parse the binding.
    @aws.FieldHint{createOnly = true; hasProviderDefault = true}
    value: (String|formae.ValueSource)?

    local parent = this

    hidden res: ApiKeyResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
