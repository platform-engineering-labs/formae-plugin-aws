/// Builds a container image from a supplied Dockerfile and pushes it to ECR.
///
/// `AWS::CodeBuild::ImageBuild` is a pure build-and-push action: it runs one
/// build on the `AWS::CodeBuild::Project` named by `projectName` and creates no
/// AWS resource of its own beyond the pushed image. The project, its IAM service
/// role and its log group are declared resources in their own right.
///
/// Preconditions that can be checked cheaply are checked before the build starts
/// — the project must exist and must be configured as described on
/// `projectName`. The ones that cannot are deliberately left to surface as real
/// AWS errors from the build itself: whether the project's network placement has
/// egress to ECR, STS and CloudWatch Logs, and whether its service role actually
/// grants the ECR pushes.
module aws.codebuild.imagebuild

import "@formae/formae.pkl"
import "../aws.pkl"

const type = "AWS::CodeBuild::ImageBuild"

/// Read-only outputs produced by the build, referenceable as resolvables via
/// `imageBuild.res.*`. `imageRef` (repo@sha256:…) is the immutable, primary
/// consumption reference; `imageUri` (repo:tag) is a convenience mutable alias.
open class ImageBuildResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden imageRef: ImageBuildResolvable = (this) {
        property = "ImageRef"
    }

    hidden imageDigest: ImageBuildResolvable = (this) {
        property = "ImageDigest"
    }

    hidden imageUri: ImageBuildResolvable = (this) {
        property = "ImageUri"
    }

    hidden imageTag: ImageBuildResolvable = (this) {
        property = "ImageTag"
    }
}

@aws.ResourceHint {
    type = module.type
    identifier = "ImageRef"
    discoverable = false
}
open class ImageBuild extends formae.Resource {

    /// ECR repository URI to push to (registry/repo). Resolvable from an
    /// AWS::ECR::Repository's `repositoryUri`. Part of the resource identity. The
    /// repository must be in the same account and region as the target (where the
    /// build project and its log group run); a mismatch is rejected.
    @aws.FieldHint { createOnly = true }
    ecrRepositoryUri: (String|formae.Resolvable)

    /// Human-facing tag for the pushed image. Part of the resource identity.
    @aws.FieldHint { createOnly = true }
    imageTag: String(matches(Regex(#"^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"#)))

    /// The full literal Dockerfile content to build. The image is built verbatim
    /// from this Dockerfile; the returned digest is the source of truth.
    @aws.FieldHint
    dockerfile: String(!isEmpty)

    /// Build arguments passed to `docker build --build-arg KEY=VALUE`.
    /// Order-insensitive; hashed canonically to gate rebuilds.
    @aws.FieldHint
    buildArgs: Mapping<String, String>?

    /// Name of the AWS::CodeBuild::Project to run the build on. Resolvable from
    /// that project's `res.name`. Part of the resource identity.
    ///
    /// The build runs `docker build` and `docker push` inside the project, so the
    /// project must declare `environment.type = "LINUX_CONTAINER"` with
    /// `privilegedMode = true`, `source.type = "NO_SOURCE"` and
    /// `artifacts.type = "NO_ARTIFACTS"`; a project that does not is rejected
    /// before any build starts. Everything the build runs is supplied per build by
    /// the plugin as a build spec override, so the project's own `source.buildSpec`
    /// is never read or written and may be any placeholder. Its service role must
    /// grant the ECR pulls and pushes for `ecrRepositoryUri` and writes to its log
    /// group; the project's compute size, build image and build timeout apply to
    /// the build.
    ///
    /// The project may be shared by several image builds: teardown stops only the
    /// builds this resource started, and never deletes the project.
    @aws.FieldHint { createOnly = true }
    projectName: (String|formae.Resolvable)

    // ── Computed outputs ────────────────────────────────────────

    /// Immutable digest reference `<repo>@sha256:…` — the primary output.
    @aws.FieldHint { hasProviderDefault = true }
    imageRef: String?

    /// The pushed manifest digest `sha256:…` alone.
    @aws.FieldHint { hasProviderDefault = true }
    imageDigest: String?

    /// Convenience mutable alias `<repo>:<tag>`.
    @aws.FieldHint { hasProviderDefault = true }
    imageUri: String?

    /// Hash over the build-affecting inputs; used to gate rebuilds.
    @aws.FieldHint { hasProviderDefault = true }
    buildConfigHash: String?

    local parent = this

    hidden res: ImageBuildResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
